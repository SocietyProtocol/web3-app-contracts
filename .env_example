# Required for networks (hardhat.config.ts)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=ABC...

# Required for Scripts

# Address of the ERC20 token used for VIP staking (e.g. MyToken)
STAKING_TOKEN_ADDRESS=0x...

# Existing Badges Proxy address (used by upgrade and info scripts)
BADGES_CONTRACT_ADDRESS=0x...
PROXY_ADDRESS=0x... # Alias for BADGES_CONTRACT_ADDRESS in some scripts

# Management Proxy Addresses
VIP_MANAGER_PROXY_ADDRESS=0x...
FACTORY_PROXY_ADDRESS=0x...

# Badge IDs
# Badge ids start from 10
GOVERNOR_BADGE_ID=10